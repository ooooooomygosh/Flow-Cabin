{
  "name": "album-circle-desktop",
  "version": "2.2.0",
  "description": "心流小屋 · Flow Cabin — a pixel lo-fi cabin for your favourite albums, focus timer and desktop cat",
  "productName": "心流小屋",
  "author": "Flow Cabin",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:native && npm run build:music && npm run build:web",
    "build:web": "npm --prefix .. run build -- --outDir desktop/web",
    "predist": "npm run build:native && npm run build:music && npm run build:web",
    "prepack": "npm run build:native && npm run build:music && npm run build:web",
    "build:native": "node build-native.cjs",
    "build:music": "node build-music.cjs",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis portable --x64",
    "pack": "electron-builder --win --x64 --dir",
    "test:library": "node test/library-ui.cjs",
    "test:room": "node test/room-ui.cjs",
    "test:improvements": "node test/improvements-ui.cjs",
    "test:cover-editor": "node test/cover-editor-ui.cjs",
    "test:music": "node test/music-ui.cjs",
    "test:night-study": "node test/night-study-ui.cjs",
    "dist:mac": "npm run build:native && npm run build:music && npm run build:web && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "npm run dist -- --publish never",
    "pack:mac": "npm run build:music && npm run build:web && electron-builder --mac --arm64 --dir --publish never",
    "test:client": "node test/home-v21-ui.cjs",
    "test:backup": "node test/backup-profile-ui.cjs",
    "test:focus": "node test/focus-ui.cjs",
    "test:focus-close": "node test/focus-close-ui.cjs",
    "test:cat-focus": "node test/cat-focus-ui.cjs",
    "test:pet": "node test/pet-ui.cjs",
    "test:sources": "node test/sources-ui.cjs",
    "test:shelf": "node test/shelf-ui.cjs",
    "screenshots": "node test/screenshots.cjs",
    "test:atmosphere": "node test/atmosphere-ui.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.albumcircle.desktop",
    "productName": "心流小屋",
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "native/mac-input.node",
      "native/mac-location.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "main/site-commands.cjs",
      "main/site-session.cjs",
      "main/updates.cjs",
      "main/menus.cjs",
      "main/autostart.cjs",
      "weather.cjs",
      "qweather.cjs",
      "ai.cjs",
      "codex-cli.cjs",
      "policy.cjs",
      "settings.cjs",
      "qq-music.cjs",
      "site-router.cjs",
      "preload.cjs",
      "wallpaper.cjs",
      "desktop-mode.cjs",
      "desktop-sink.cjs",
      "fullscreen.cjs",
      "mini-player.cjs",
      "media-keys.cjs",
      "thumbar.cjs",
      "mini-preload.cjs",
      "tray-icons.cjs",
      "status-bar.cjs",
      "typing-hook.cjs",
      "input-stats.cjs",
      "native/*.node",
      "shell-protocol.cjs",
      "wallpaper-model.cjs",
      "wallpaper-preload.cjs",
      "pet.cjs",
      "pet-physics.cjs",
      "pet-fullscreen.cjs",
      "focus-shell.cjs",
      "pet-preload.cjs",
      "companion-sync.cjs",
      "now-playing.cjs",
      "apple-music.cjs",
      "local-app.cjs",
      "updater.cjs",
      "mac-updater.cjs",
      "local-music.cjs",
      "collection-store.cjs",
      "catalog-search.mjs",
      "musicbrainz-scheduler.mjs",
      "music-service.cjs",
      "music-policy.cjs",
      "music-upstream.cjs",
      "playlists.cjs",
      "music-login.cjs",
      "vendor/simple-music/LICENSE",
      "vendor/simple-music/SOURCE.txt",
      "vendor/node-forge-encrypt-only/**/*",
      "web/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "lyrics-service.cjs",
      "lyrics-match.cjs",
      "lan-certificate.cjs",
      "lan-model.cjs",
      "lan-service.cjs",
      "live-session.cjs",
      "pet-pack.cjs",
      "dsh-bridge.cjs",
      "weather-api.cjs",
      "pet-pack-metadata.cjs",
      "pet-atlas.cjs",
      "pet-menu.cjs",
      "lyric-window.cjs",
      "lyric-preload.cjs",
      "pet-menu-preload.cjs",
      "location.cjs",
      "webm-pet.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "FlowCabin-${version}-${arch}-setup.${ext}",
      "extraResources": [
        {
          "from": "native/bin",
          "to": "native",
          "filter": [
            "DesktopHost.exe",
            "NowPlaying.exe",
            "ApproximateLocation.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "心流小屋",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "FlowCabin-${version}-${arch}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "identity": "Flow Cabin Local Signing",
      "hardenedRuntime": false,
      "artifactName": "FlowCabin-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "心流小屋读取并控制 Music 或 Spotify 正在播放的歌曲，用于在小屋唱机上显示。",
        "NSLocationWhenInUseUsageDescription": "使用大致位置显示附近天气与日出日落。仅在你使用小屋时获取，不持续追踪。",
        "NSLocationUsageDescription": "使用大致位置显示附近天气与日出日落。"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ooooooomygosh",
        "repo": "Flow-Cabin",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "electron-updater": "6.8.9",
    "music-metadata": "11.16.1",
    "NeteaseCloudMusicApi": "4.32.0",
    "node-forge": "file:./vendor/node-forge-encrypt-only",
    "uiohook-napi": "1.5.5",
    "ws": "8.22.0"
  },
  "overrides": {
    "music-metadata": "$music-metadata",
    "basic-ftp": "6.2.3",
    "node-forge": "$node-forge"
  },
  "engines": {
    "node": "24.x"
  }
}
